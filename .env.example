# The production server only needs these non-secret runtime settings.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# ── A INTELIGENCIA DOS MORADORES (opcional) ─────────────────────────────────
#
# Sem chave nenhuma o jogo roda inteiro: os moradores respondem pelas falas do
# bairro, que sao montadas dentro do jogo e nao custam nada. A chave so
# acrescenta a resposta nos quatro momentos extremos.
#
# A GRATUITA (Groq) tem preferencia sobre a paga quando as duas existem.
# Copie este arquivo para ".env" e cole a chave la — ".env" nao vai para o git.
XBW_CHAVE_GROQ=
XBW_MODELO_GROQ=llama-3.3-70b-versatile

# A PAGA (Anthropic), se um dia for ligada. Deixe vazia para usar a gratuita.
XBW_CHAVE_IA=
XBW_MODELO_IA=
